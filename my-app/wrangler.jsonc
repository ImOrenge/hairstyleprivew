{
  "$schema": "node_modules/wrangler/config-schema.json",
  // my-app/wrangler.jsonc
"name": "hairstyleprivew",
  "main": ".open-next/worker.js",
  "minify": true,
  "find_additional_modules": true,
  "base_dir": ".open-next/middleware",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "HAIRSTYLE_RSS_PROXY_URL": "https://dpzdhxlqnogfpubpslbf.supabase.co/functions/v1/hairstyle-rss-proxy"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        ".next/**"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workflows": [
    {
      "name": "hairfit-generation-workflow",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow",
      "script_name": "hairfit-generation-workflow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
