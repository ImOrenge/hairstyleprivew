{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hairfit.app/schemas/hairstyle-blueprint-v4.json",
  "title": "HairFit Hairstyle Blueprint v4",
  "type": "array",
  "minItems": 25,
  "maxItems": 25,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "slug",
      "nameKo",
      "description",
      "lengthBucket",
      "correctionFocus",
      "silhouette",
      "texture",
      "bangType",
      "volumeFocusTags",
      "faceShapeFitTags",
      "avoidTags",
      "promptTemplate",
      "promptTemplateVersion",
      "styleTargets",
      "trendKeywords",
      "baselineTrendScore",
      "baselineFreshnessScore",
      "styleFamily",
      "variantKey",
      "primaryTexture",
      "compatibleTextureTags",
      "avoidTextureTags",
      "primaryStrandThickness",
      "compatibleStrandThicknessTags",
      "avoidStrandThicknessTags",
      "primaryCondition",
      "compatibleConditionTags",
      "avoidConditionTags",
      "requiredServices",
      "serviceConstraints",
      "maintenanceLevel",
      "introducedIn"
    ],
    "properties": {
      "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "nameKo": { "type": "string", "minLength": 4 },
      "description": { "type": "string", "minLength": 20 },
      "lengthBucket": { "enum": ["short", "medium", "long"] },
      "correctionFocus": { "enum": ["crown", "temple", "jawline"] },
      "silhouette": { "type": "string", "minLength": 3 },
      "texture": { "type": "string", "minLength": 3 },
      "bangType": { "type": "string", "minLength": 3 },
      "volumeFocusTags": { "$ref": "#/$defs/nonEmptyStrings" },
      "faceShapeFitTags": { "$ref": "#/$defs/nonEmptyStrings" },
      "avoidTags": { "$ref": "#/$defs/strings" },
      "promptTemplate": { "type": "string", "minLength": 40 },
      "promptTemplateVersion": { "const": "catalog-v4" },
      "styleTargets": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": { "enum": ["male", "female"] }
      },
      "trendKeywords": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 2 } },
      "baselineTrendScore": { "type": "number", "minimum": 0, "maximum": 99 },
      "baselineFreshnessScore": { "type": "number", "minimum": 0, "maximum": 99 },
      "styleFamily": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "variantKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "primaryTexture": { "enum": ["straight", "wavy_curly", "tight_curly_frizzy"] },
      "compatibleTextureTags": { "$ref": "#/$defs/nonEmptyStrings" },
      "avoidTextureTags": { "$ref": "#/$defs/strings" },
      "primaryStrandThickness": { "enum": ["fine", "medium", "coarse"] },
      "compatibleStrandThicknessTags": { "$ref": "#/$defs/nonEmptyStrings" },
      "avoidStrandThicknessTags": { "$ref": "#/$defs/strings" },
      "primaryCondition": { "enum": ["untreated", "damaged", "bleached", "colored"] },
      "compatibleConditionTags": { "$ref": "#/$defs/nonEmptyStrings" },
      "avoidConditionTags": { "$ref": "#/$defs/strings" },
      "requiredServices": { "$ref": "#/$defs/nonEmptyStrings" },
      "serviceConstraints": { "$ref": "#/$defs/nonEmptyStrings" },
      "maintenanceLevel": { "enum": ["low", "medium", "high"] },
      "introducedIn": { "enum": ["expansion-a", "expansion-b", "expansion-c"] }
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
