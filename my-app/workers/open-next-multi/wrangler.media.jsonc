{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hairfit-media",
  "main": "media-server.js",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": ["nodejs_compat", "allow_importable_env", "global_fetch_strictly_public"],
  "alias": {
    "critters": "./missing-optional-dependency.js",
    "@opentelemetry/api": "next/dist/compiled/@opentelemetry/api"
  },
  "minify": true,
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "HAIRFIT_SOURCE_REVISION": "unversioned"
  },
  "workflows": [
    {
      "name": "hairfit-generation-workflow",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow",
      "script_name": "hairfit-generation-workflow"
    },
    {
      "name": "hairfit-styling-workflow",
      "binding": "STYLING_WORKFLOW",
      "class_name": "StylingWorkflow",
      "script_name": "hairfit-generation-workflow"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hairstyleprivew-router"
    },
    {
      "binding": "REPORT_PDF_WORKER",
      "service": "hairfit-report-pdf"
    }
  ],
  "observability": {
    "enabled": true
  }
}
